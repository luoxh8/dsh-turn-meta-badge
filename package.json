{
  "name": "dsh-turn-meta-badge",
  "version": "0.1.0",
  "private": true,
  "description": "Show the model, reasoning effort and token usage at the bottom-right of every assistant reply in the DeepSeek Harness web GUI.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "token-usage",
    "model"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "README.md"
  ],
  "license": "MIT"
}
